#!/usr/bin/env bash
# revoke-ssh <username>
# Kills live sessions + deletes account + home + metadata.
set -euo pipefail
USERNAME="${1:?usage: revoke-ssh <username>}"
if id "$USERNAME" >/dev/null 2>&1; then
  pkill -KILL -u "$USERNAME" 2>/dev/null || true
  skill=$(pgrep -u "$USERNAME" 2>/dev/null || true)
  [ -n "$skill" ] && pkill -KILL -u "$USERNAME" || true
  sleep 1
  userdel -r "$USERNAME" 2>/dev/null || userdel "$USERNAME" 2>/dev/null || true
fi
rm -f "/var/lib/temp-ssh-${USERNAME}.meta"
echo "revoke-ssh: $USERNAME removed"