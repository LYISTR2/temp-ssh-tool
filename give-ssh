#!/usr/bin/env bash
# give-ssh <username> [hours]
# Creates a temporary SSH user with a random strong password, auto-expires.
# Usage as root:
#   give-ssh alice 2        # account + password valid 2h, then locked & removed
# Default expiry: 2h.
set -euo pipefail

USERNAME="${1:?usage: give-ssh <username> [hours]}"
HOURS="${2:-2}"

# validate
[[ "$USERNAME" =~ ^[a-z][a-z0-9_-]{1,31}$ ]] || { echo "invalid username" >&2; exit 1; }
[[ "$HOURS" =~ ^[0-9]+$ ]] || { echo "hours must be integer" >&2; exit 1; }

if id "$USERNAME" >/dev/null 2>&1; then
  echo "user exists - removing first" >&2
  /usr/local/sbin/revoke-ssh "$USERNAME" 2>/dev/null || userdel -r "$USERNAME" 2>/dev/null || true
fi

# random 20-char password from safe alphabet
PASS="$(openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 20)"

useradd -m -s /bin/bash "$USERNAME"
usermod -aG tempssh "$USERNAME"
echo "$USERNAME:$PASS" | chpasswd

# Primary enforcement = systemd-run hard revoke at exact TTL.
# chage is belt-and-braces only: expire at end of the TTL day (chage is day-granular).
expiry_date="$(date -d "+${HOURS} hours + 1 day" +%Y-%m-%d)"  # day-granularity: pad +1day so the login window covers the full TTL
expiry_iso="$(date -d "+${HOURS} hours" +%Y-%m-%dT%H:%M:%S)"
chage -E "$expiry_date" "$USERNAME" || true

# Also chage the password itself so even cached sessions see expiry
# mark metadata for revoke + logging
echo "$USERNAME|$expiry_date|$(date +%s)" > "/var/lib/temp-ssh-${USERNAME}.meta"

# Systemd temp cleanup: also hard-delete after double the TTL in case expiry missed
systemd-run --on-active="${HOURS}h" --unit="tmpusr-del-${USERNAME}" \
  /usr/local/sbin/revoke-ssh "$USERNAME" >/dev/null 2>&1 || true

echo "✓ 临时 SSH 账号已创建"
echo "  用户名: $USERNAME"
echo "  密码:   $PASS"
echo "  有效期: ${HOURS}小时 (至 $expiry_iso UTC, 超时自动封禁)"
echo "  登录:   ssh ${USERNAME}@$(hostname -I | awk '{print $1}')"
echo "  手动立即撤销: revoke-ssh $USERNAME"